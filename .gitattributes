# Normalize source/documentation for Windows, MATLAB, and GitHub.
* text=auto
*.md text eol=lf
*.m text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.S text eol=lf
*.ld text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.overlay text eol=lf
*.fis text eol=lf
*.scad text eol=lf
*.html text eol=lf
*.step text eol=lf
CMakeLists.txt text eol=lf
Kconfig text eol=lf

# Preserve binary design, simulation, and media assets byte-for-byte.
*.slx binary
*.mdl text eol=lf
*.mat binary
*.stl binary
*.3mf binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.zip binary
